{
  // The live suite is named apart from the mock-server suite so that only one of
  // them runs at a time; knip matches specs by name, so it needs telling.
  "entry": ["frontend/src/App.tsx", "e2e/live/*.live-spec.ts"],
  "project": ["**/*.{js,ts,jsx,tsx}"],
  "ignore": ["docs/**/*.js", "static/**/*.js", "templates/**/*.js", "frontend/plugins/**/*"],
  "ignoreDependencies": [
    // CLI
    "webpack-bundle-analyzer",
    // used internally by eslint-plugin-import-x
    "eslint-import-resolver-typescript"
  ],
  // knip's lefthook plugin inspects .git/hooks directly, which crashes with
  // ENOTDIR in a git worktree (there .git is a file, not a directory). The
  // plugin only contributes hook-script analysis; the dependency itself is
  // still detected through the `prepare` script in package.json.
  "lefthook": false,
  "ignoreBinaries": [
    // to use `export` command
    "export"
  ],
  // The live suite runs against a real server and has its own config, which is
  // not the one knip discovers on its own.
  "playwright": {
    "config": ["e2e/playwright.config.ts", "e2e/live/playwright.config.ts"]
  }
}