{
  "description": "Enforce the repository's minimum quality gate after Codex changes files.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/agent_quality_gate.py\"",
            "timeout": 30,
            "statusMessage": "Recording the quality-gate baseline"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/agent_quality_gate.py\"",
            "timeout": 60,
            "statusMessage": "Running the minimum quality gate"
          }
        ]
      }
    ]
  }
}
